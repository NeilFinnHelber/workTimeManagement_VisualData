{
  "info": {
    "_postman_id": "visualdata-put-tests",
    "name": "visualData PUT Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "PUT User - Valid",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type","value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Alice Updated\",\n  \"email\": \"alice.updated@example.com\",\n  \"role\": \"developer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["users","1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status is 200', () => { pm.response.to.have.status(200); });",
              "",
              "pm.test('Success message', () => {",
              "    const json = pm.response.json();",
              "    pm.expect(json.message).to.include('updated');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT User - Missing Fields",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type","value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Only Name\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/1",
          "host": ["{{baseUrl}}"],
          "path": ["users","1"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Should return 400', () => { pm.response.to.have.status(400); });",
              "",
              "pm.test('Error message exists', () => {",
              "    pm.expect(pm.response.json()).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "PUT User - Invalid ID",
      "request": {
        "method": "PUT",
        "header": [{"key": "Content-Type","value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test\",\n  \"email\": \"test@example.com\",\n  \"role\": \"developer\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/users/99999",
          "host": ["{{baseUrl}}"],
          "path": ["users","99999"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Should return 404 or handled error', () => {",
              "    pm.expect([404,500]).to.include(pm.response.code);",
              "});",
              "",
              "pm.test('Has message', () => {",
              "    pm.expect(pm.response.json()).to.have.property('message');",
              "});"
            ]
          }
        }
      ]
    },
